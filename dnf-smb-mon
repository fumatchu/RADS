#!/bin/bash
#Patch 1.1 - Fixed version comparison for DC builds
# dnf_smb_mon
# Monitoring script that compares MAIN VERSION (not release) of installed Samba DC
# with upstream Rocky repository. Alerts when upstream has newer main version.

LOG="/var/log/dnf-smb-mon.log"

# Get installed samba-dc version (e.g., 4.22.4-106.el10_1.dc -> 4.22.4)
INSTALLED_FULL=$(rpm -q samba-dc --qf '%{VERSION}-%{RELEASE}' 2>/dev/null)
INSTALLED_VER=$(rpm -q samba-dc --qf '%{VERSION}' 2>/dev/null)

if [ -z "$INSTALLED_VER" ]; then
  logger -s "dnf-smb-mon: samba-dc not installed" 2>>$LOG
  exit 0
fi

# Get upstream samba version from repo (e.g., 4.22.4-6.el10 -> 4.22.4)
dnf makecache -q 2>/dev/null
UPSTREAM_FULL=$(dnf info samba 2>/dev/null | grep "^Version" | head -1 | awk '{print $3}')

if [ -z "$UPSTREAM_FULL" ]; then
  logger -s "dnf-smb-mon: Cannot get upstream version" 2>>$LOG
  exit 1
fi

UPSTREAM_VER="$UPSTREAM_FULL"

# Compare main versions (X.Y.Z)
if [ "$INSTALLED_VER" == "$UPSTREAM_VER" ]; then
  # Same main version - all good
  rm -f /etc/motd
  logger -s "dnf-smb-mon: OK - installed $INSTALLED_FULL, upstream $UPSTREAM_VER" 2>>$LOG
else
  # Different main versions - check if upstream is newer
  NEWER=$(printf '%s\n' "$INSTALLED_VER" "$UPSTREAM_VER" | sort -V | tail -1)

  if [ "$NEWER" == "$UPSTREAM_VER" ] && [ "$NEWER" != "$INSTALLED_VER" ]; then
    # Upstream is newer - alert!
    cat <<EOF >/etc/motd
*********************************************
            ATTENTION!
*********************************************
New Samba version available in upstream repository!

Installed (DC build): $INSTALLED_FULL
Upstream available:   $UPSTREAM_VER

You should rebuild samba-dc with the new version.
Run: samba-dnf-pkg-update
EOF
    logger -s "dnf-smb-mon: UPDATE AVAILABLE - installed $INSTALLED_VER, upstream $UPSTREAM_VER" 2>>$LOG
  else
    # Installed is same or newer - all good
    rm -f /etc/motd
    logger -s "dnf-smb-mon: OK - installed $INSTALLED_FULL (upstream $UPSTREAM_VER)" 2>>$LOG
  fi
fi
